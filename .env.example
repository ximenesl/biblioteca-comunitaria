# ==============================================================================
# Variáveis de Ambiente da Aplicação Biblioteca Comunitária
# Copie este arquivo para .env caso deseje personalizar os parâmetros locais.
# ==============================================================================

# Porta HTTP do servidor Tomcat embarcado
SERVER_PORT=8080

# Perfil ativo do Spring Boot (default, dev, prod, test)
SPRING_PROFILES_ACTIVE=default

# Configurações do Banco de Dados H2 em Memória
SPRING_DATASOURCE_URL=jdbc:h2:mem:bibliotecadb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Console web do H2 Database (acesso em /h2-console)
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_PATH=/h2-console

# Configurações do Springdoc OpenAPI / Swagger UI
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
